{
  "name": "techpulse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TechPulse Backend REST API, RSS Ingestion Engine, Web Push & Telegram Notification Scheduler",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/worker.js",
    "ingest": "node -e \"import('./src/services/news/rssIngestor.js').then(m => m.runIngestionCycle()).then(r => { console.log(JSON.stringify(r, null, 2)); process.exit(0); })\"",
    "generate:vapid": "node -e \"import('web-push').then(({ default: wp }) => console.log(wp.generateVAPIDKeys()))\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
